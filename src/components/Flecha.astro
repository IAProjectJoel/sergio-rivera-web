---
interface Props {
  direccion?: 'derecha' | 'izquierda';
}
const { direccion = 'derecha' } = Astro.props;
---

<svg
  width="15"
  height="15"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  style={direccion === 'izquierda' ? 'transform: rotate(180deg)' : undefined}
>
  <line x1="4" y1="12" x2="19" y2="12"></line>
  <polyline points="13 6 19 12 13 18"></polyline>
</svg>
