---
import type { Estado } from '@/content.config';
import { useT, type Lang } from '@/i18n/utils';

interface Props {
  estado: Estado;
  lang: Lang;
  /** 'punto' = solo el círculo, para la esquina de la foto.
      'linea' = círculo + palabra, para pies de foto y fichas. */
  variante?: 'punto' | 'linea';
}

const { estado, lang, variante = 'linea' } = Astro.props;
const t = useT(lang);

// El punto rojo es la convención de galería para "vendido": quien conoce
// el mundillo lo lee al instante, y el resto ve la palabra al lado.
// "Disponible" no se marca — es el caso por defecto y no aporta nada.
const visible = estado !== 'disponible';
const etiqueta = t(`estado.${estado}` as 'estado.vendida');
---

{
  visible && (
    <span class:list={['estado', `estado--${estado}`, `estado--${variante}`]} title={etiqueta}>
      <span class="estado__punto" aria-hidden="true" />
      {variante === 'linea' ? <span class="estado__texto">{etiqueta}</span> : <span class="solo-lectores">{etiqueta}</span>}
    </span>
  )
}

<style>
  .estado {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }

  .estado__punto {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    flex: none;
  }

  .estado--vendida {
    color: var(--sold);
  }

  .estado--vendida .estado__punto {
    background: var(--sold);
  }

  .estado--reservada {
    color: var(--accent);
  }

  .estado--reservada .estado__punto {
    background: transparent;
    border: 1.5px solid var(--accent);
  }

  /* Obra que no está en venta (colección privada, premio, no se vende):
     en gris, porque no es una venta que presumir ni una oportunidad. */
  .estado--no_venta {
    color: var(--ink-faint);
  }

  .estado--no_venta .estado__punto {
    background: transparent;
    border: 1.5px solid var(--ink-faint);
  }

  /* Sobre la foto: el punto necesita un halo para leerse contra
     cualquier pintura, sea clara u oscura. */
  .estado--punto {
    padding: 0.4rem;
    background: color-mix(in srgb, var(--bone) 92%, transparent);
    border-radius: 50%;
    backdrop-filter: blur(4px);
    box-shadow: 0 1px 6px rgb(20 18 24 / 0.14);
  }

  .estado--punto .estado__punto {
    width: 0.55rem;
    height: 0.55rem;
  }
</style>
