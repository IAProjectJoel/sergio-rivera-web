---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useT, type Lang } from '@/i18n/utils';

interface Props {
  imagenes: ImageMetadata[];
  alt: string;
  lang: Lang;

}

const { imagenes, alt, lang } = Astro.props;
const t = useT(lang);
const principal = imagenes[0];
const secundarias = imagenes.slice(1);
---

<div class="visor" data-visor>
  {
    principal && (
      <button class="visor__principal" type="button" data-abrir aria-label={t('obra.ampliar')}>
        <Image
          src={principal}
          alt={alt}
          widths={[480, 720, 1080, 1600]}
          sizes="(max-width: 56rem) 92vw, 44rem"
          quality={88}
          loading="eager"
          fetchpriority="high"
          data-principal
        />
        <span class="visor__lupa" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <circle cx="11" cy="11" r="7" />
            <line x1="16.5" y1="16.5" x2="21" y2="21" />
            <line x1="11" y1="8" x2="11" y2="14" />
            <line x1="8" y1="11" x2="14" y2="11" />
          </svg>
        </span>
      </button>
    )
  }

  {
    secundarias.length > 0 && (
      <ul class="visor__tiras">
        {imagenes.map((img, i) => (
          <li>
            <button
              type="button"
              class="visor__tira"
              data-tira={i}
              aria-label={`${alt} — ${i + 1}`}
              aria-current={i === 0 ? 'true' : 'false'}
            >
              <Image src={img} alt="" widths={[120, 240]} sizes="6rem" quality={70} loading="lazy" />
            </button>
          </li>
        ))}
      </ul>
    )
  }
</div>

<dialog class="lupa" data-lupa aria-label={t('obra.ampliar')}>
  <button class="lupa__cerrar" type="button" data-cerrar aria-label={t('nav.cerrar')}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="6" y1="6" x2="18" y2="18"></line>
      <line x1="18" y1="6" x2="6" y2="18"></line>
    </svg>
  </button>
  <img data-lupa-img alt={alt} />
</dialog>

<script>
  // Ampliar la foto a pantalla completa. Con un cuadro, el detalle de la
  // pincelada es medio argumento de venta: tiene que poder verse de cerca.
  const visor = document.querySelector<HTMLElement>('[data-visor]');
  const lupa = document.querySelector<HTMLDialogElement>('[data-lupa]');

  if (visor && lupa) {
    const principal = visor.querySelector<HTMLImageElement>('[data-principal]');
    const lupaImg = lupa.querySelector<HTMLImageElement>('[data-lupa-img]');
    const tiras = Array.from(visor.querySelectorAll<HTMLButtonElement>('[data-tira]'));

    // Guarda el srcset original de cada miniatura para poder intercambiarlas.
    const fuentes = tiras.map((tira) => {
      const img = tira.querySelector('img');
      return { src: img?.src ?? '', srcset: img?.srcset ?? '' };
    });

    // Cambiar de foto: la miniatura pasa a ser la principal.
    tiras.forEach((tira, i) => {
      tira.addEventListener('click', () => {
        if (!principal) return;
        const fuente = fuentes[i];
        if (!fuente) return;
        principal.src = fuente.src;
        principal.srcset = fuente.srcset;
        for (const otra of tiras) otra.setAttribute('aria-current', 'false');
        tira.setAttribute('aria-current', 'true');
      });
    });

    visor.querySelector('[data-abrir]')?.addEventListener('click', () => {
      if (!principal || !lupaImg) return;
      lupaImg.src = principal.currentSrc || principal.src;
      lupa.showModal();
      document.body.style.overflow = 'hidden';
    });

    const cerrar = () => {
      lupa.close();
      document.body.style.overflow = '';
    };

    lupa.querySelector('[data-cerrar]')?.addEventListener('click', cerrar);
    lupa.addEventListener('close', () => {
      document.body.style.overflow = '';
    });
    // Pulsar fuera de la imagen también cierra.
    lupa.addEventListener('click', (evento) => {
      if (evento.target === lupa) cerrar();
    });
  }
</script>

<style>
  .visor__principal {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--bone-2);
    cursor: zoom-in;
    position: relative;
    overflow: hidden;
  }

  .visor__principal img {
    width: 100%;
    height: auto;
    box-shadow: 0 20px 55px -32px rgb(22 21 26 / 0.5);
  }

  .visor__lupa {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--bone) 90%, transparent);
    color: var(--ink);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity var(--transicion);
  }

  .visor__principal:hover .visor__lupa,
  .visor__principal:focus-visible .visor__lupa {
    opacity: 1;
  }

  .visor__tiras {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
  }

  .visor__tira {
    width: 4.5rem;
    padding: 0;
    border: 1px solid transparent;
    background: var(--bone-2);
    cursor: pointer;
    opacity: 0.62;
    transition: opacity var(--transicion), border-color var(--transicion);
  }

  .visor__tira:hover,
  .visor__tira[aria-current='true'] {
    opacity: 1;
    border-color: var(--line);
  }

  .visor__tira img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .lupa {
    width: min(94vw, 78rem);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .lupa::backdrop {
    background: rgb(18 16 20 / 0.92);
    backdrop-filter: blur(3px);
  }

  .lupa img {
    width: 100%;
    max-height: 92vh;
    object-fit: contain;
    margin-inline: auto;
  }

  .lupa__cerrar {
    position: fixed;
    top: 1.1rem;
    right: 1.1rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    cursor: pointer;
    transition: background var(--transicion);
  }

  .lupa__cerrar:hover {
    background: rgb(255 255 255 / 0.2);
  }

  @media (max-width: 30rem) {
    .visor__tira {
      width: 3.5rem;
    }
  }
</style>
