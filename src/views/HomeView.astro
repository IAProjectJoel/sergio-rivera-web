---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import ObraGrid from '@/components/ObraGrid.astro';
import Flecha from '@/components/Flecha.astro';
import { sitio } from '@/data/sitio';
import { otroIdioma, ruta, rutaDe, useT, type Lang } from '@/i18n/utils';
import {
  coleccionesRaiz,
  coleccionesVisibles,
  descripcionColeccion,
  nombreColeccion,
  obrasDestacadas,
  portada,
  resolverImagen,
  textoAlt,
  todasLasObras,
  tituloDe,
} from '@/lib/obras';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const destacadas = await obrasDestacadas(6);
const colecciones = await coleccionesRaiz();
const todas = await todasLasObras();
const todasLasSeries = await coleccionesVisibles();

/** Slug → slug de su serie madre, para saber qué obra cuenta en qué serie. */
const padrePorSlug = new Map(todasLasSeries.map((c) => [c.id, c.data.padre?.id]));

// La obra de portada: la primera destacada. Es la primera impresión de la web.
const heroObra = destacadas[0];
const heroImg = heroObra ? portada(heroObra) : undefined;

const cuadricula = destacadas.slice(1);

/**
 * Portada de una serie: la suya propia, o la primera obra que contenga —
 * contando las de sus subseries, para que "Coches" no salga en blanco si
 * todos sus cuadros están bajo "Porsche".
 */
function portadaSerie(slug: string, propia?: string) {
  if (propia) return resolverImagen(propia);
  const primera = todas.find((o) => {
    const suya = o.data.coleccion?.id;
    return suya === slug || (suya !== undefined && padrePorSlug.get(suya) === slug);
  });
  return primera ? portada(primera) : undefined;
}
---

<Layout
  lang={lang}
  titulo={sitio.artista}
  descripcion={t('meta.inicio.desc')}
  altHref={ruta('inicio', otroIdioma(lang))}
>
  <section class="hero">
    <div class="contenedor hero__grid">
      <div class="hero__texto">
        <p class="hero__rotulo">{lang === 'es' ? 'Pintor · Madrid' : 'Painter · Madrid'}</p>
        <h1 class="hero__titulo">
          Sergio Rivera<span class="hero__apellido">Martínez</span>
        </h1>
        <p class="hero__intro">{t('inicio.intro')}</p>
        <a class="boton" href={ruta('obras', lang)}>{t('inicio.verTodo')}</a>
      </div>

      {
        heroObra && heroImg && (
          <figure class="hero__obra">
            <a href={rutaDe('obra', heroObra.id, lang)} class="hero__enlace">
              <Image
                src={heroImg}
                alt={textoAlt(heroObra, lang)}
                widths={[480, 720, 1080, 1440]}
                sizes="(max-width: 56rem) 88vw, 40rem"
                quality={86}
                loading="eager"
                fetchpriority="high"
              />
              <figcaption class="hero__pie">
                <span class="hero__pieTitulo">{tituloDe(heroObra, lang)}</span>
              </figcaption>
            </a>
          </figure>
        )
      }
    </div>
  </section>

  {
    cuadricula.length > 0 && (
      <section class="seccion">
        <div class="contenedor">
          <div class="cabecera-seccion">
            <h2>{t('inicio.destacadas')}</h2>
            <a class="enlace-flecha" href={ruta('obras', lang)}>
              {t('inicio.verTodo')}
              <Flecha />
            </a>
          </div>
          <ObraGrid obras={cuadricula} lang={lang} prioritarias={0} />
        </div>
      </section>
    )
  }

  {
    colecciones.length > 0 && (
      <section class="seccion seccion--series">
        <div class="contenedor">
          <h2 class="cabecera-seccion">{t('inicio.colecciones')}</h2>

          <ul class="series">
            {colecciones.map((col) => {
              const img = portadaSerie(col.id, col.data.portada);
              const desc = descripcionColeccion(col, lang);
              return (
                <li class="serie">
                  <a class="serie__enlace" href={rutaDe('coleccion', col.id, lang)}>
                    <div class="serie__marco">
                      {img && (
                        <Image
                          src={img}
                          alt=""
                          widths={[320, 560, 840]}
                          sizes="(max-width: 44rem) 90vw, 26rem"
                          quality={80}
                          loading="lazy"
                          class="serie__img"
                        />
                      )}
                    </div>
                    <h3 class="serie__titulo">{nombreColeccion(col, lang)}</h3>
                    {desc && <p class="serie__desc">{desc}</p>}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <section class="seccion">
    <div class="contenedor sobre">
      <div class="medida-texto">
        <p class="rotulo">{t('inicio.sobreMi')}</p>
        <p class="sobre__frase">
          {
            lang === 'es'
              ? 'Podría decirse que pinto desde que nací. Del grafiti de Majadahonda al realismo al óleo, siempre con la nostalgia como motivo.'
              : 'You could say I have painted since the day I was born. From the graffiti of Majadahonda to oil realism, always with nostalgia as my subject.'
          }
        </p>
        <a class="enlace-flecha" href={ruta('sobreMi', lang)}>
          {t('nav.sobreMi')}
          <Flecha />
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 5vw, 5rem);
  }

  .hero__rotulo {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 1.1rem;
  }

  .hero__titulo {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
  }

  .hero__apellido {
    font-style: italic;
    color: var(--accent);
    padding-left: 0.06em;
  }

  .hero__intro {
    font-size: 1.06rem;
    color: var(--ink-soft);
    max-width: 30ch;
    margin-bottom: 2rem;
  }

  .hero__obra {
    margin: 0;
  }

  .hero__enlace {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .hero__enlace img {
    width: 100%;
    box-shadow: 0 18px 50px -28px rgb(22 21 26 / 0.45);
  }

  .hero__pie {
    margin-top: 0.85rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .hero__pieTitulo {
    font-family: var(--font-display);
    font-size: 1rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  .seccion--series {
    background: var(--bone-2);
  }

  .series {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .serie__enlace {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .serie__marco {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bone);
    margin-bottom: 1rem;
  }

  .serie__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .serie__enlace:hover .serie__img {
    transform: scale(1.04);
  }

  .serie__titulo {
    font-size: 1.35rem;
    margin-bottom: 0.35rem;
  }

  .serie__desc {
    font-size: 0.875rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .sobre__frase {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2rem);
    line-height: 1.35;
    margin-bottom: 1.75rem;
  }

  @media (max-width: 52rem) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero__obra {
      order: -1;
    }
  }
</style>
